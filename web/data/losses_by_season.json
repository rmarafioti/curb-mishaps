{
  "name": "losses_by_season",
  "label": "Losses by season",
  "description": "Total loss, frequency and routine severity per season.",
  "metrics": [
    {
      "name": "total_mishap_loss",
      "label": "Total Mishap Loss",
      "description": "Every kept mishap: realized + hypothetical + catastrophic. Hypothetical losses always count; loss_kind is only a slice."
    },
    {
      "name": "mishap_count",
      "label": "Mishaps",
      "description": "Number of kept mishaps."
    },
    {
      "name": "episode_count",
      "label": "Episodes",
      "description": "Number of episodes, including those with no mishap."
    },
    {
      "name": "mishaps_per_episode",
      "label": "Mishaps per Episode",
      "description": "Kept mishaps / episodes. The frequency trend; no dollars, so inflation can't affect it."
    },
    {
      "name": "median_routine_mishap_cost_2026",
      "label": "Median Routine Mishap Cost (2026 $)",
      "description": "The severity trend with inflation removed: the lower median cost across the routine mishaps in each group (e.g. per season), each converted to 2026 dollars. With an even number of mishaps it is the lower of the middle two, not their average. Catastrophic mishaps (the divorce, the house fire, Latte Larry's) are excluded so a single outlier can't move a season's median; they are forecast separately as rare events."
    }
  ],
